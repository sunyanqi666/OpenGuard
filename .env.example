# Copy this file to .env before starting the project.
# Use local-only values and never commit real credentials.
FASTAPI_ENV=development

PROJECT_NAME="OpenGuard"

# Generate a value with: openssl rand -hex 32
SECRET_KEY=replace-with-a-random-secret-of-at-least-32-characters
FIRST_SUPERUSER=admin@example.com
FIRST_SUPERUSER_PASSWORD=replace-with-a-local-admin-password

# Emails
SMTP_HOST=localhost
EMAILS_FROM_EMAIL=info@example.com
SMTP_TLS=False
SMTP_PORT=1025

# PostgreSQL
POSTGRES_PASSWORD=replace-with-a-local-database-password
DATABASE_URL=postgresql://postgres:${POSTGRES_PASSWORD}@localhost:5432/app
